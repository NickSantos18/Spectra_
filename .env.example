# Chaves de API das listas publicas de reputacao. Todas sao opcionais:
# sem chave, o provedor correspondente e simplesmente ignorado.
SPECTRA_GSB_API_KEY=
SPECTRA_VT_API_KEY=
SPECTRA_PHISHTANK_APP_KEY=

# Acesso e banco
SPECTRA_BD=dados/spectra.db
SPECTRA_SEGREDO=troque-por-uma-chave-longa-e-aleatoria
SPECTRA_COOKIE_SEGURO=0
SPECTRA_AMBIENTE=desenvolvimento
SPECTRA_ORIGEM_PUBLICA=http://127.0.0.1:8000

# Login com Google (opcional)
SPECTRA_GOOGLE_CLIENT_ID=
SPECTRA_GOOGLE_CLIENT_SECRET=
SPECTRA_GOOGLE_REDIRECT=http://127.0.0.1:8000/auth/google/callback

# Envio de confirmação de e-mail e recuperação de senha (SMTP com TLS)
SPECTRA_SMTP_HOST=
SPECTRA_SMTP_PORTA=587
SPECTRA_SMTP_USUARIO=
SPECTRA_SMTP_SENHA=
SPECTRA_SMTP_REMETENTE=

# Admins não são configurados aqui. Cadastre-se no site e, no terminal do servidor:
#   python -m spectra_link_guard.admin master seu@email.com

# Assistente com IA (opcional). Sem chave, os chats usam respostas por regra.
# Gemini: chave em https://aistudio.google.com/api-keys. Tem prioridade.
GEMINI_API_KEY=
# SPECTRA_GEMINI_MODELO=gemini-3.8-flash
# Groq: chave em https://console.groq.com/keys. Usado quando não houver chave Gemini.
GROQ_API_KEY=
# Claude: pago. Instale com: pip install -e ".[ia]"
ANTHROPIC_API_KEY=
# SPECTRA_IA_MODELO=claude-opus-5-5
# SPECTRA_IA=0   # desliga a IA mesmo com chave

# ── Admin inicial ────────────────────────────────────────────────────────────
# Semeado na subida do servidor. Existe para hospedagem sem acesso ao shell
# (onde `python -m spectra_link_guard.admin master` é inalcançável) e sem disco
# persistente (onde o banco é recriado a cada deploy). Idempotente: se a conta
# já existe, só garante o papel. Sem as duas primeiras, nada acontece.
SPECTRA_ADMIN_EMAIL=
SPECTRA_ADMIN_SENHA=
SPECTRA_ADMIN_NOME=Administração
